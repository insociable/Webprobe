{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": ["BETTER_AUTH_URL"],
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_FROM",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "SMTP_SECURE",
        "REPORT_PUBLIC_BASE_URL",
        "REPORT_TOKEN_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["RUN_DB_INTEGRATION", "RUN_REDIS_INTEGRATION"],
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "REPORT_PUBLIC_BASE_URL",
        "REPORT_TOKEN_SECRET",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL"
      ]
    }
  }
}
