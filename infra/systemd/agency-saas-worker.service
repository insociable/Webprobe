[Unit]
Description=Agency SaaS scanner worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=vboxuser
Group=vboxuser
WorkingDirectory=/srv/agency-saas
Environment=NODE_ENV=production
EnvironmentFile=/srv/agency-saas/.env
ExecStart=/usr/bin/node /srv/agency-saas/apps/worker/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
MemoryHigh=768M
MemoryMax=1G
TasksMax=256
LimitNOFILE=4096

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
