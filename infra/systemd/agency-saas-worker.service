[Unit]
Description=Agency SaaS scanner worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=vboxuser
Group=vboxuser
WorkingDirectory=/srv/agency-saas
Environment=NODE_ENV=production
EnvironmentFile=/srv/agency-saas/.env
ExecStart=/usr/bin/node /srv/agency-saas/apps/worker/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
MemoryHigh=768M
MemoryMax=1G
TasksMax=256
LimitNOFILE=4096

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Defense in depth: the scanner may reach public Internet targets and localhost
# services, but not RFC1918/CGNAT/link-local/multicast/documentation ranges.
IPAddressAllow=localhost
IPAddressDeny=0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4
IPAddressDeny=fc00::/7 fe80::/10 ff00::/8 2001:db8::/32

[Install]
WantedBy=multi-user.target
