# Infrastructure locale
POSTGRES_DB=agency_saas
POSTGRES_USER=agency_saas
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_PORT=5432
VALKEY_PASSWORD=replace-with-a-long-random-value
VALKEY_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Connexions applicatives
DATABASE_URL=postgresql://agency_saas:password@127.0.0.1:5432/agency_saas
REDIS_URL=redis://:password@127.0.0.1:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# E-mail
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@webprobe.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Runtime de scan
PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
SCAN_ARTIFACTS_DIR=storage/scan-artifacts
AGENCY_MONITOR_USER_AGENT=AgencyMonitor/1.0
WEBPROBE_RUNTIME_ENV=development
WEBPROBE_INTERNAL_DEEP_WORKER=disabled

# Intelligence de vulnérabilités
VULNERABILITY_SYNC_ENABLED=0
VULNERABILITY_SYNC_INTERVAL_SECONDS=86400
VULNERABILITY_SYNC_RUN_ON_START=0
NVD_API_KEY=

# Limites de l’audit public
PUBLIC_AUDIT_USER_HOURLY_LIMIT=6
PUBLIC_AUDIT_USER_CONCURRENT_LIMIT=2
PUBLIC_AUDIT_DOMAIN_COOLDOWN_SECONDS=600
PUBLIC_AUDIT_RETENTION_DAYS=90
PUBLIC_AUDIT_RETENTION_BATCH_SIZE=100
PUBLIC_AUDIT_RETENTION_INTERVAL_SECONDS=21600

# Rapports partageables
REPORT_PUBLIC_BASE_URL=http://localhost:3000
REPORT_TOKEN_SECRET=replace-with-at-least-32-random-characters
