{
  "name": "@agency-saas/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:browser": "tsx scripts/browser-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run --passWithNoTests --no-file-parallelism"
  },
  "dependencies": {
    "@agency-saas/contracts": "workspace:*",
    "@agency-saas/db": "workspace:*",
    "@agency-saas/security": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "bullmq": "6.3.8",
    "dotenv": "18.0.1",
    "drizzle-orm": "0.45.3",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.10",
    "pino": "10.3.1",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
